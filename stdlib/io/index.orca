package std::io;

import java::lang::System;

# Printing functions for console output

def println() {
    System::out.println();
}

def println(any value) {
    System::out.println(value);
}

def println(string value) {
    System::out.println(value);
}

def println(byte value) {
    System::out.println(value);
}

def println(short value) {
    System::out.println(value);
}

def println(int value) {
    System::out.println(value);
}

def println(long value) {
    System::out.println(value);
}

def println(bool value) {
    System::out.println(value);
}

def println(float value) {
    System::out.println(value);
}

def println(double value) {
    System::out.println(value);
}

def println(char value) {
    System::out.println(value);
}

